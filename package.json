{
  "name": "hexo-server",
  "version": "3.0.0",
  "description": "Server module of Hexo.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "eslint": "eslint .",
    "test": "mocha test/index.js",
    "test-cov": "nyc --reporter=lcovonly npm run test",
    "build-dts": "tsc --emitDeclarationOnly --declaration --noEmit false -p tsconfig.json",
    "build": "tsc -b tsconfig.json && npm run build-dts",
    "watch": "npx -y nodemon --delay 5 --watch build.js --watch lib --ext js,ts --exec \"yarn build > build.log 2>&1 && yarn workspace hexo-site exec \\\"hexo generate --verbose --debug\\\"\""
  },
  "directories": {
    "lib": "./dist"
  },
  "files": [
    "dist/"
  ],
  "repository": "hexojs/hexo-server",
  "homepage": "https://hexo.io/",
  "keywords": [
    "hexo",
    "server",
    "connect"
  ],
  "author": "Tommy Chen <tommy351@gmail.com> (https://zespia.tw)",
  "maintainers": [
    "Abner Chou <hi@abnerchou.me> (https://abnerchou.me)"
  ],
  "license": "MIT",
  "dependencies": {
    "bluebird": "^3.7.2",
    "compression": "^1.7.4",
    "connect": "^3.7.0",
    "mime": "^3.0.0",
    "morgan": "^1.10.0",
    "open": "^8.4.0",
    "picocolors": "^1.1.1",
    "serve-static": "^1.15.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "18",
    "binary-collections": "^2.0.10",
    "chai": "^4.3.6",
    "chai-as-promised": "^7.1.1",
    "eslint": "^8.23.0",
    "eslint-config-hexo": "^5.0.0",
    "hexo": "*",
    "hexo-fs": "^4.0.0",
    "hexo-util": "^3.0.1",
    "mocha": "^10.0.0",
    "nyc": "^15.1.0",
    "rewire": "^7.0.0",
    "sinon": "^15.0.1",
    "supertest": "^6.2.4",
    "typescript": "^5.8.3",
    "uuid": "^9.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
